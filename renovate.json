{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only what Dependabot cannot see: the Nim compiler version pinned in the workflows. Dependabot keeps the GitHub Actions up to date.",
  "extends": ["config:best-practices"],
  "enabledManagers": ["custom.regex"],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "nim-version: X.Y.Z of setup-nim-action",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/", "/^\\.github/actions/[^/]+/action\\.ya?ml$/"],
      "matchStrings": ["nim-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"],
      "depNameTemplate": "nim-lang/Nim",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "the second entry of the nim matrix in ci.yml (the first is the floor of grpc.nimble and stays)",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["nim: \\[\"\\d+\\.\\d+\\.\\d+\", \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\]"],
      "depNameTemplate": "nim-lang/Nim",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["nim-lang/Nim"],
      "commitMessageTopic": "Nim in CI",
      "prBodyNotes": ["A new Nim minor version may need changes in the library (see docs/nim-compiler-notes.md). The floor in `grpc.nimble` and the first entry of the CI matrix are not touched by this update."]
    }
  ]
}
